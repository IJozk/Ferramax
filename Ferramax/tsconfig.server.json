{
    "compilerOptions": {
      "experimentalDecorators": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "outDir": "dist",
      "rootDir": "src",
      "module": "nodenext"
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
    "paths": {
        "@/*": ["./src/*"]
      }
  }